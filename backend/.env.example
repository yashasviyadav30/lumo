YOUTUBE_API_KEY=
# Groq key for the smart agent. Zero Data Retention must be on in Groq Data Controls.
GROQ_API_KEY=
# Postgres connection string (Supabase session pooler until launch)
DATABASE_URL=
# Keys the log pseudonyms. Generate once; keep it the same across deploys.
SECRET_KEY=
# Google Gemini key for video summaries and mind maps (empty = the Summary tab says it's not available)
GEMINI_API_KEY=
# Optional: models tried in turn when one is busy
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Optional: your own Google sign-in client ID (the app's public one is the default; empty hides the Google buttons)
# GOOGLE_CLIENT_ID=
